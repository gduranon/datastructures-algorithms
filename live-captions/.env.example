# Copiá este archivo como .env y completá las claves (nunca lo subas a git).
# Proveedores: STT_PROVIDER = elevenlabs | openai | macos ; LLM_PROVIDER = anthropic | openai
STT_PROVIDER=elevenlabs
LLM_PROVIDER=anthropic

ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
# Opcionales
# ELEVENLABS_STT_MODEL=scribe_v1
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
# CONTEXT_SEGMENTS=40
# MACOS_CONFIDENCE=0.9
# SPEAKER_THRESHOLD=0.55

# Solo si algún proveedor es "openai" (OpenAI o cualquier API compatible)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=
# OPENAI_STT_MODEL=whisper-1
# Si la voz usa otro servidor que el LLM:
# OPENAI_STT_BASE_URL=
# OPENAI_STT_API_KEY=
